# Environment
.env
.env.local

# Local data — SQLite databases, ingest buffers, GeoIP
data/
/tmp/

# Build output
/bin/
/dist/
/feasible

# JavaScript dependencies. tracker/dist/ is deliberately NOT ignored: the built
# bundle is committed so `go build` embeds it without a JavaScript toolchain.
node_modules
tracker/test-results/
tracker/playwright-report/

# The dashboard's unit tests are bundled here before node --test runs them.
web/.test-build/

# Dependency directories the ecosystem packages create when somebody actually
# installs them. Every package here vendors nothing and depends on nothing, so
# these only ever appear on a contributor's machine.
ecosystem/**/vendor/
ecosystem/**/__pycache__/
ecosystem/**/*.egg-info/
ecosystem/**/.pytest_cache/
ecosystem/**/*.gem

# Browser automation scratch (see global CLAUDE.md)
.playwright/
.playwright-cli/

# macOS
.DS_Store

# Agent worktree scratch
.claude/worktrees/
