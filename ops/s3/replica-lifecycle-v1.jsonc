//
// replica-lifecycle-v1.jsonc
// Versioned S3-compatible lifecycle template for every replica under one shard.
//
// Created: 2026-08-31
// Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
//
// This commented file is a reviewable template, not direct API input. Render
// valid JSON with:
//   feasible litestream policy -replica-url s3://BUCKET/SHARD_PREFIX
{
  "Rules": [
    {
      "ID": "feasible-replica-expiration-v1",
      "Status": "Enabled",
      "Filter": { "Prefix": "SHARD_PREFIX/" },
      "Expiration": { "Days": 2 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 2 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
