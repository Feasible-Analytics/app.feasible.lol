//
// replica-access-v1.jsonc
// Minimal S3-compatible permissions for replica data and lifecycle control.
//
// Created: 2026-08-31
// Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
//
// These are three separate reviewable policy templates. Replace BUCKET and
// SHARD_PREFIX before installation. The lifecycle owner applies the rule once;
// the deployment checker only reads it; Litestream only reads and writes the
// replica objects. Provider lifecycle, not an application principal, expires
// objects. None of these roles needs s3:DeleteObject.
{
  "replicator": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": ["s3:ListBucket"],
        "Resource": ["arn:aws:s3:::BUCKET"],
        "Condition": {"StringLike": {"s3:prefix": ["SHARD_PREFIX/*"]}}
      },
      {
        "Effect": "Allow",
        "Action": ["s3:GetBucketLocation"],
        "Resource": ["arn:aws:s3:::BUCKET"]
      },
      {
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:PutObject"],
        "Resource": ["arn:aws:s3:::BUCKET/SHARD_PREFIX/*"]
      }
    ]
  },
  "deployment_checker": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "s3:GetBucketVersioning",
          "s3:GetBucketLocation",
          "s3:GetLifecycleConfiguration",
          "s3:GetBucketObjectLockConfiguration"
        ],
        "Resource": ["arn:aws:s3:::BUCKET"]
      }
    ]
  },
  "lifecycle_owner": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": ["s3:PutLifecycleConfiguration"],
        "Resource": ["arn:aws:s3:::BUCKET"]
      }
    ]
  }
}
