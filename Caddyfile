#
# Caddyfile
# Local reverse proxy, with the same routing shape production uses.
#
# Created: 2026-08-30
# Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
#
# Port 19300 is the only port anyone opens in a browser. Production differs in
# hostnames and TLS only — the three rules below are identical, so a routing bug
# found locally is the same routing bug production would have had.
#
# The Make targets set the placeholders; the defaults are the loopback values, so
# `caddy run` on its own still works. The `-ts` targets point them at the
# Tailscale address instead.
{
	# Nothing here is ever addressed by hostname, and a certificate attempt on a
	# private address just produces noise in the log.
	auto_https off
}

# The site label carries only the port so MagicDNS and direct-IP Host headers
# both match. `bind` limits the socket to loopback or Tailscale without turning
# that interface address into an accidental HTTP Host matcher.
http://:{$FEASIBLE_CADDY_PORT:19300} {
	bind {$FEASIBLE_CADDY_BIND:127.0.0.1}

	# Service and observability paths share each process socket but are denied at
	# the public edge. Trusted services and monitoring connect directly through
	# the protected network instead of through Caddy.
	handle /internal/* {
		respond "404 page not found" 404
	}
	handle /metrics {
		respond "404 page not found" 404
	}

	# The tracker's endpoint. Kept on its own process so the front door scales
	# horizontally without dragging the dashboard along with it.
	handle /api/event* {
		reverse_proxy {$FEASIBLE_CADDY_INGEST_UPSTREAM:127.0.0.1:19302}
	}

	# Everything else: dashboard, API, tracker script, static assets.
	handle {
		reverse_proxy {$FEASIBLE_CADDY_APP_UPSTREAM:127.0.0.1:19301}
	}
}
