#
# .env.sample
# Every environment variable this project reads, with a comment and a default.
#
# Created: 2026-08-30
# Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
#
# Copy this file to .env for local development. .env is git-ignored; this file
# is the contract. A variable that is not in here, with a comment explaining it
# and a sane default, does not exist — `make check-env` fails the build if the
# Go source reads one that is missing.
#
# Values are resolved in this order, first match wins:
#   1. $CONFIG_DIR/<NAME>   a file, for Docker and systemd secrets
#   2. the environment
#   3. this file, as .env   (development only — never read in production)
#
# Production deploys only the section each process needs. The split is by which
# file a variable lands in, never by renaming: FEASIBLE_LOG_LEVEL means the same
# thing on both machines, and the shared values must match between them.

# Directory of secret files, one file per variable, named after the variable.
# Unset locally; set to /run/secrets under Docker or /etc/feasible/secrets under
# systemd. A file here beats the environment.
# CONFIG_DIR=/run/secrets

# ── Shared — both apps need these, and the values must match ──────────────────

# Deployment environment. "production" turns on JSON logs at info by default and
# stops .env being read at all, so a stray file cannot override a real deploy.
FEASIBLE_ENV=development

# Minimum level to log: debug, info, warn or error. debug locally, info in
# production. At debug the event, shard-poll, outbox and roll-up lines are loud
# on purpose — they are what people actually debug.
FEASIBLE_LOG_LEVEL=debug

# Log encoding: text or json. text locally because you read it, json in
# production because a machine does.
FEASIBLE_LOG_FORMAT=text

# HMAC keys shared between the ingest tier and the shards, as JSON. Every entry
# carries an id so a rotation can add the new key everywhere before anything
# starts signing with it. These values must be identical on every machine —
# because both apps read one file locally, a mismatch is the one failure local
# development can never catch.
FEASIBLE_INTERNAL_KEYS=[{"id":"dev-01","secret":"dev-only-change-me"}]

# Print the fully derived event — geo, fingerprint, channel, every parsed field —
# for every request. The local twin of the X-Debug-Request header, and the same
# thing as the --trace-events flag. Never on in production: it logs a line per
# request.
FEASIBLE_TRACE_EVENTS=false

# The key that encrypts the fingerprint salts at rest, as 64 hex characters
# (32 bytes). Leave it unset and one is generated into
# $FEASIBLE_APP_DATA_DIR/salt.key on first run, which is what makes "encrypted
# at rest" true by default rather than only when somebody remembered to set it.
# Treat this as being as sensitive as raw IP logs: the key plus the stored
# hashes is enough to brute-force a visitor's IP and user agent back out.
# FEASIBLE_SALT_KEY=

# ── App only ──────────────────────────────────────────────────────────────────

# Public listen address for the dashboard, the API and the tracker. Caddy proxies
# to it; nothing but Caddy should reach it.
FEASIBLE_APP_LISTEN=127.0.0.1:19301

# Private listen address for /internal/*. This stays on 127.0.0.1 in every mode,
# including over Tailscale: /internal/salts hands out the secret that turns a
# visitor hash back into an IP address, and it must not be routable from any
# public or tailnet interface.
FEASIBLE_APP_INTERNAL_LISTEN=127.0.0.1:19401

# Where control.db, the per-account databases, backups and downloaded data files
# live. One directory is the whole install: back it up and you have everything.
FEASIBLE_APP_DATA_DIR=./data

# The URL people actually type. It is baked into the tracker snippet, every email
# link and the OAuth redirect URIs, so it must move whenever the bind address
# does — the `-ts` Make targets set both together. Prefer a hostname over an IP:
# Google rejects a bare private IP as a redirect URI.
FEASIBLE_APP_BASE_URL=http://localhost:19300

# How the app receives events: "direct" runs ingestion in the same process (the
# self-hoster path, and `make dev-solo`), "http" expects a separate ingest tier
# to forward them (the production shape, and `make dev`).
FEASIBLE_APP_TRANSPORT=direct

# How email is sent: "log" prints the message and writes the rendered HTML under
# tmp/mail/, which is why local development needs no SMTP service at all.
FEASIBLE_APP_MAIL_TRANSPORT=log

# The envelope sender for every message the product sends — the verification
# code, the password reset, the new-device notice, and the ten lifecycle emails.
# It applies to both transports. A relay rejects a From address it does not own,
# and that rejection is the single most common reason a self-hoster's mail
# silently stops arriving. It is a repliable address rather than a no-reply one
# because several of these messages ask for a reply.
FEASIBLE_APP_MAIL_FROM=feasible.lol <hello@feasible.lol>

# Where the volume ladder points a growing customer. The 70%-of-plan email
# names this address, which is the whole point of warning early: it turns a
# limit into a conversation while there is still a month of runway.
FEASIBLE_APP_SALES_EMAIL=sales@feasible.lol

# The key that encrypts two-factor secrets at rest and signs the short-lived
# cookies (CSRF, the OAuth PKCE verifier, the pending two-factor login), as 64
# hex characters (32 bytes). Leave it unset and one is generated into
# $FEASIBLE_APP_DATA_DIR/app.key on first run, which is what makes "encrypted at
# rest" true by default rather than only when somebody remembered to set it.
# Lose it and every enrolled authenticator app stops working.
# FEASIBLE_APP_SECRET_KEY=

# The mail server, used only when FEASIBLE_APP_MAIL_TRANSPORT is smtp. The host
# is required in that mode and the process refuses to start without it, because
# a box that silently could not send email would look healthy while nobody could
# reset a password.
# FEASIBLE_SMTP_HOST=smtp.example.com

# The submission port. 587 with STARTTLS is what every hosted provider offers.
# 465 is TLS from the first byte and is detected from this number rather than
# configured separately, because nobody remembers which is which.
FEASIBLE_SMTP_PORT=587

# The SMTP username. Leave it empty for a relay on the same machine that accepts
# unauthenticated local mail.
# FEASIBLE_SMTP_USERNAME=

# The SMTP password, sent only after STARTTLS when the server offers it. Mount
# it as a secrets file under $CONFIG_DIR in production rather than putting it in
# an environment variable.
# FEASIBLE_SMTP_PASSWORD=

# Upgrade the connection with STARTTLS on port 587 or 25. Ignored on 465, which
# is already encrypted. Only turn this off for a relay on localhost.
FEASIBLE_SMTP_STARTTLS=true

# The Google OAuth client for "sign in with Google". Both values must be set
# together or not at all — a half-configured client produces a button that
# starts a flow it cannot finish. With neither set the button is hidden and the
# process logs one line at start-up saying which variable is missing.
#
# Google rejects a bare private IP as a redirect URI and requires HTTPS for
# anything that is not localhost, so testing over Tailscale needs the MagicDNS
# hostname in FEASIBLE_APP_BASE_URL. The redirect URI to register is
# <FEASIBLE_APP_BASE_URL>/auth/google/callback.
# FEASIBLE_GOOGLE_CLIENT_ID=

# The other half of the Google OAuth client. It never leaves the server: the
# authorization code is exchanged for tokens from here, not from the browser.
# FEASIBLE_GOOGLE_CLIENT_SECRET=

# ── App only: billing ─────────────────────────────────────────────────────────
#
# Every variable in this section is empty on a self-hosted install, and that is
# a supported state rather than a broken one: the billing screens say "not
# available on this install" and everything else works exactly as it does here.

# The payment provider's secret key, sk_test_… or sk_live_…. Setting it without
# both price ids below is refused at boot, because a checkout button that fails
# at the provider fails in front of somebody who was trying to pay. It is also
# what lets the delete-account flow remove a customer record — a deletion that
# left the customer behind would leave a card that can still be charged.
# FEASIBLE_STRIPE_SECRET_KEY=

# The publishable key. It is safe in a browser and is only used by the hosted
# checkout redirect.
# FEASIBLE_STRIPE_PUBLISHABLE_KEY=

# The product every price belongs to. Nothing reads it on the request path; it
# is here so a deployment can be checked against the right provider account.
# FEASIBLE_STRIPE_PRODUCT=

# The monthly price, $9.99.
# FEASIBLE_STRIPE_PRICE_MONTHLY=

# The yearly price, $100 — ten months' price for twelve.
# FEASIBLE_STRIPE_PRICE_YEARLY=

# The webhook signing secret. Empty makes /webhooks/stripe refuse every
# delivery, which is the right default: an unverified webhook endpoint is a
# public URL that changes billing state. Locally, get one from
# `stripe listen --forward-to localhost:19301/webhooks/stripe`.
# FEASIBLE_STRIPE_WEBHOOK_SECRET=

# ── Public API, MCP and webhooks ──────────────────────────────────────────────

# Requests per hour per API key, for keys that carry no limit of their own. This
# is configurable at all because the incumbent's equivalent is hard-coded at 600
# even in the build people run on their own hardware, and the workaround people
# actually use is editing their database by hand. Ten thousand an hour is past
# the point where any dashboard, export or scheduled report is the problem.
FEASIBLE_API_RATE_LIMIT=10000

# How long one webhook delivery attempt may take before it is treated as failed.
# This is the only place in the system where we wait on a third party, which is
# why deliveries run on the job queue and never on a request path — a customer
# endpoint that takes thirty seconds costs a worker thirty seconds and costs
# event collection nothing.
FEASIBLE_WEBHOOK_TIMEOUT_SECONDS=10

# How long the webhook worker waits when its queue is empty. It loops without
# pausing while there is work, so this only sets how quickly a newly queued
# delivery is picked up on an idle instance.
FEASIBLE_WEBHOOK_POLL_SECONDS=5

# The API key `feasible mcp` runs its stdio session as, for a desktop assistant
# that launches the binary itself. Unset by default: the remote MCP endpoint at
# /mcp authenticates per request instead, and nothing should be running a stdio
# server on a shared machine. It is an environment variable rather than a flag
# because a secret on the command line is visible in the process list.
# FEASIBLE_MCP_API_KEY=
# ── Ingest only ───────────────────────────────────────────────────────────────

# Listen address for the ingest tier. Caddy routes /api/event* here.
FEASIBLE_INGEST_LISTEN=127.0.0.1:19302

# Comma-separated shard base URLs. Shards are the source of truth for routing:
# the ingestor polls each one for its domain list, forwards what is in the map
# and drops what is not. Wrong list, silently no data.
FEASIBLE_INGEST_SHARDS=http://127.0.0.1:19401

# Addresses allowed to set the X-Feasible-IP header, comma-separated, as bare
# addresses or CIDR blocks. Empty means nobody, which is the right default: on an
# instance exposed straight to the internet, an unconditionally trusted override
# lets anyone forge their own geolocation and split their own fingerprint. Set
# this to your load balancer only.
# FEASIBLE_INGEST_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# The store-and-forward outbox. Events are written here and acknowledged with a
# 202 before any network call, so a shard being down never loses an event or
# slows down a visitor's page.
FEASIBLE_INGEST_BUFFER_PATH=./data/ingest/buffer.db

