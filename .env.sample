#
# .env.sample
# Every environment variable this project reads, with a comment and a default.
#
# Created: 2026-08-30
# Copyright (c) 2026 Cloudmanic Labs, LLC. All rights reserved.
#
# Copy this file to .env for local development. .env is git-ignored; this file
# is the contract. A variable that is not in here, with a comment explaining it
# and a sane default, does not exist — `make check-env` fails the build if the
# Go source reads one that is missing.
#
# Values are resolved in this order, first match wins:
#   1. $CONFIG_DIR/<NAME>   a file, for Docker and systemd secrets
#   2. the environment
#   3. this file, as .env   (development only — never read in production)
#
# Production deploys only the section each process needs. The split is by which
# file a variable lands in, never by renaming: FEASIBLE_LOG_LEVEL means the same
# thing on both machines, and the shared values must match between them.

# Directory of secret files, one file per variable, named after the variable.
# Unset locally; set to /run/secrets under Docker or /etc/feasible/secrets under
# systemd. A file here beats the environment.
# CONFIG_DIR=/run/secrets

# ── Shared — app shards and ingesters need these values to match ──────────────────

# Deployment environment. "production" turns on JSON logs at info by default and
# stops .env being read at all, so a stray file cannot override a real deploy.
FEASIBLE_ENV=development

# Minimum level to log: debug, info, warn or error. debug locally, info in
# production. At debug the event, direct-write and roll-up lines are loud on
# purpose — they are what people actually debug.
FEASIBLE_LOG_LEVEL=debug

# Log encoding: text or json. text locally because you read it, json in
# production because a machine does.
FEASIBLE_LOG_FORMAT=text

# Ordered HMAC signing keys for private app-shard requests. Ingesters sign with
# the first key; app shards accept every key, which permits rotation without a
# coordinated restart. Mount production secrets through CONFIG_DIR.
FEASIBLE_INTERNAL_KEYS=[{"id":"dev-01","secret":"dev-only-change-me"}]

# Print the fully derived event — geo, fingerprint, channel, every parsed field —
# for every request. The local twin of the X-Debug-Request header, and the same
# thing as the --trace-events flag. Never on in production: it logs a line per
# request.
FEASIBLE_TRACE_EVENTS=false

# The key that encrypts the fingerprint salts at rest, as 64 hex characters
# (32 bytes). Leave it unset and one is generated into
# $FEASIBLE_APP_DATA_DIR/salt.key on first run, which is what makes "encrypted
# at rest" true by default rather than only when somebody remembered to set it.
# Treat this as being as sensitive as raw IP logs: the key plus the stored
# hashes is enough to brute-force a visitor's IP and user agent back out.
# FEASIBLE_SALT_KEY=

# ── App only ──────────────────────────────────────────────────────────────────

# Public listen address for the dashboard, the API and the tracker. Caddy proxies
# to it; nothing but Caddy should reach it.
FEASIBLE_APP_LISTEN=127.0.0.1:19301

# Private listen address for health, metrics, domain routing, salt distribution,
# and durable ingest delivery. Never publish /internal/* through the public
# load balancer.
FEASIBLE_APP_INTERNAL_LISTEN=127.0.0.1:19401

# One-based stable identity for this app shard. It must match this app's
# position in every ingester's ordered FEASIBLE_INGEST_SHARDS list.
FEASIBLE_APP_SHARD_ID=1

# Where system.db, the per-account databases, backups and downloaded data files
# live. One directory is the whole install: back it up and you have everything.
FEASIBLE_APP_DATA_DIR=./data

# The URL people actually type. It is baked into the tracker snippet, every email
# link and the OAuth redirect URIs, so it must move whenever the bind address
# does — the `-ts` Make targets set both together. Prefer a hostname over an IP:
# Google rejects a bare private IP as a redirect URI.
FEASIBLE_APP_BASE_URL=http://localhost:19300

# Which public process owns /api/event: "direct" mounts it in the app process
# (`make dev-solo`), while "http" leaves it to the separate store-and-forward
# ingest process (`make dev`).
FEASIBLE_APP_TRANSPORT=direct

# Whether this process is Cloudmanic Labs' hosted service. Self-hosters leave
# this false and control their own providers. Hosted production refuses to boot
# unless the public subprocessor inventory below names every required role.
FEASIBLE_APP_HOSTED=false

# The legal entities used by the hosted deployment. These local values are
# intentionally conspicuous placeholders, not claims about production vendors.
# Production hosted mode requires compute, object_storage and email roles, plus
# billing when hosted billing is enabled, with every field replaced by facts.
FEASIBLE_HOSTED_SUBPROCESSORS_JSON='[{"role":"compute","legal_entity":"LOCAL PLACEHOLDER - not a production subprocessor","service":"Local process","data":"Local test data only","region":"Developer workstation"},{"role":"object_storage","legal_entity":"LOCAL PLACEHOLDER - not a production subprocessor","service":"Local object-store emulator","data":"Local encrypted replica test data only","region":"Developer workstation"},{"role":"email","legal_entity":"LOCAL PLACEHOLDER - not a production subprocessor","service":"Log mail transport","data":"Local test addresses and messages only","region":"Developer workstation"}]'

# How email is sent: "log" prints the message and writes the rendered HTML under
# tmp/mail/, which is why local development needs no SMTP service at all.
FEASIBLE_APP_MAIL_TRANSPORT=log

# Whether this process drains the background job queue — the hourly scheduler
# that sends weekly and monthly reports, and the spike and drop alert evaluator.
# Set it to false on every app replica but one: the jobs are idempotent, so two
# workers are safe, but a developer's laptop should not be sending a customer's
# weekly report.
FEASIBLE_APP_WORKER=true

# The envelope sender for every message the product sends — the verification
# code, the password reset, the new-device notice, and the ten lifecycle emails.
# It applies to both transports. A relay rejects a From address it does not own,
# and that rejection is the single most common reason a self-hoster's mail
# silently stops arriving. It is a repliable address rather than a no-reply one
# because several of these messages ask for a reply.
FEASIBLE_APP_MAIL_FROM=feasible.lol <hello@feasible.lol>

# Where the volume ladder points a growing customer. The 70%-of-plan email
# names this address, which is the whole point of warning early: it turns a
# limit into a conversation while there is still a month of runway.
FEASIBLE_APP_SALES_EMAIL=sales@feasible.lol

# The legal person or organization running this self-hosted installation.
# FEASIBLE_OPERATOR_NAME=Example Organization, Inc.
# The operator's legal postal address shown on privacy and DPA pages.
# FEASIBLE_OPERATOR_ADDRESS=123 Example Street, Example City, Country
# The operator's privacy contact address; Cloudmanic appears only in hosted mode.
# FEASIBLE_OPERATOR_EMAIL=privacy@example.com

# The key that encrypts two-factor secrets at rest and signs the short-lived
# cookies (CSRF, the OAuth PKCE verifier, the pending two-factor login), as 64
# hex characters (32 bytes). Leave it unset and one is generated into
# $FEASIBLE_APP_DATA_DIR/app.key on first run, which is what makes "encrypted at
# rest" true by default rather than only when somebody remembered to set it.
# Lose it and every enrolled authenticator app stops working.
# FEASIBLE_APP_SECRET_KEY=

# The mail server, used only when FEASIBLE_APP_MAIL_TRANSPORT is smtp. The host
# is required in that mode and the process refuses to start without it, because
# a box that silently could not send email would look healthy while nobody could
# reset a password.
# FEASIBLE_SMTP_HOST=smtp.example.com

# The submission port. 587 with STARTTLS is what every hosted provider offers.
# 465 is TLS from the first byte and is detected from this number rather than
# configured separately, because nobody remembers which is which.
FEASIBLE_SMTP_PORT=587

# The SMTP username. Leave it empty for a relay on the same machine that accepts
# unauthenticated local mail.
# FEASIBLE_SMTP_USERNAME=

# The SMTP password, sent only after STARTTLS when the server offers it. Mount
# it as a secrets file under $CONFIG_DIR in production rather than putting it in
# an environment variable.
# FEASIBLE_SMTP_PASSWORD=

# Upgrade the connection with STARTTLS on port 587 or 25. Ignored on 465, which
# is already encrypted. Only turn this off for a relay on localhost.
FEASIBLE_SMTP_STARTTLS=true

# The Google OAuth client. One application covers all three Google features —
# "sign in with Google", importing history from Analytics, and reading Search
# Console — because they are three scopes, not three clients. Both values must
# be set together or not at all: a half-configured client produces a button that
# starts a flow it cannot finish. With neither set every Google feature hides
# itself and the process logs one line at start-up saying which variable is
# missing.
#
# Google rejects a bare private IP as a redirect URI and requires HTTPS for
# anything that is not localhost, so testing over Tailscale needs the MagicDNS
# hostname in FEASIBLE_APP_BASE_URL. The redirect URI to register is
# <FEASIBLE_APP_BASE_URL>/auth/google/callback.
# FEASIBLE_GOOGLE_CLIENT_ID=

# The other half of the Google OAuth client. It never leaves the server: the
# authorization code is exchanged for tokens from here, not from the browser.
# FEASIBLE_GOOGLE_CLIENT_SECRET=

# ── App only: billing ─────────────────────────────────────────────────────────
#
# Every variable in this section is empty on a self-hosted install, and that is
# a supported state rather than a broken one: the billing screens say "not
# available on this install" and everything else works exactly as it does here.
# Hosted checkout explicitly uses Stripe Managed Payments. For supported
# transactions labelled "Sold through Link," Sold through Link, LLC is merchant
# of record. The Stripe account must have accepted the Managed Payments terms,
# and the product must use a tax code eligible for Managed Payments.
# Before deploying, run `feasible billing preflight --checkout-smoke`. The
# read-only form intentionally does not pass because Stripe does not expose
# activation, accepted terms or the tax-code eligibility label as API fields;
# the smoke creates no customer or charge and expires its monthly and yearly
# Checkout Sessions.

# The payment provider's secret key, sk_test_… or sk_live_…. Setting it without
# both price ids below is refused at boot, because a checkout button that fails
# at the provider fails in front of somebody who was trying to pay. It is also
# what lets the delete-account flow remove a customer record — a deletion that
# left the customer behind would leave a card that can still be charged.
# FEASIBLE_STRIPE_SECRET_KEY=

# The publishable key. It is safe in a browser and is only used by the hosted
# checkout redirect.
# FEASIBLE_STRIPE_PUBLISHABLE_KEY=

# The product every price belongs to. Nothing reads it on the request path; it
# is here so a deployment can be checked against the right provider account.
# The hosted SaaS product uses the Managed Payments-eligible tax code
# txcd_10103001 (Software as a service, business use).
# FEASIBLE_STRIPE_PRODUCT=

# The monthly price, $9.99.
# FEASIBLE_STRIPE_PRICE_MONTHLY=

# The yearly price, $100 — ten months' price for twelve.
# FEASIBLE_STRIPE_PRICE_YEARLY=

# The webhook signing secret. Empty makes /webhooks/stripe refuse every
# delivery, which is the right default: an unverified webhook endpoint is a
# public URL that changes billing state. Locally, get one from
# `stripe listen --forward-to localhost:19301/webhooks/stripe`.
# The deployed endpoint must include checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, customer.subscription.paused,
# customer.subscription.resumed, invoice.payment_succeeded,
# invoice.payment_failed, and invoice.finalization_failed. The endpoint must
# render events with Stripe API version 2025-03-31.basil. `feasible billing
# preflight` checks the endpoint registered for FEASIBLE_APP_BASE_URL and prints
# any missing events or version mismatch.
# FEASIBLE_STRIPE_WEBHOOK_SECRET=

# ── Public API, MCP and webhooks ──────────────────────────────────────────────

# Requests per hour per API key, for keys that carry no limit of their own. This
# is configurable at all because the incumbent's equivalent is hard-coded at 600
# even in the build people run on their own hardware, and the workaround people
# actually use is editing their database by hand. Ten thousand an hour is past
# the point where any dashboard, export or scheduled report is the problem.
FEASIBLE_API_RATE_LIMIT=10000

# How long one webhook delivery attempt may take before it is treated as failed.
# This is the only place in the system where we wait on a third party, which is
# why deliveries run on the job queue and never on a request path — a customer
# endpoint that takes thirty seconds costs a worker thirty seconds and costs
# event collection nothing.
FEASIBLE_WEBHOOK_TIMEOUT_SECONDS=10

# How long the webhook worker waits when its queue is empty. It loops without
# pausing while there is work, so this only sets how quickly a newly queued
# delivery is picked up on an idle instance.
FEASIBLE_WEBHOOK_POLL_SECONDS=5

# How many repeated event and session fact-row reads a report may be estimated
# to perform before it is answered from deterministic event or session fact-row
# buckets rather than exactly. Additive totals are expanded; rates and
# distribution statistics are calculated within the sample, and every result is labelled as estimated in
# meta.sampling and on each metric. A caller can ask for the slow exact answer
# with "exact": true. Empty takes the
# query engine's own ceiling; a negative value turns automatic sampling off
# entirely, which is the setting for somebody who would rather wait than
# estimate. It applies to the dashboard and the public API alike.
# FEASIBLE_QUERY_SAMPLE_THRESHOLD=10000000

# The API key `feasible mcp` runs its stdio session as, for a desktop assistant
# that launches the binary itself. Unset by default: the remote MCP endpoint at
# /mcp authenticates per request instead, and nothing should be running a stdio
# server on a shared machine. It is an environment variable rather than a flag
# because a secret on the command line is visible in the process list.
# FEASIBLE_MCP_API_KEY=
# ── Ingest only ───────────────────────────────────────────────────────────────

# Listen address for the ingest tier. Caddy routes /api/event* here.
FEASIBLE_INGEST_LISTEN=127.0.0.1:19302

# Private listen address for the ingest tier's /metrics and health probes. It is
# a second listener rather than a path on the one above, and it stays on
# loopback for the same reason the app's does. It differs from the app's port so
# that both processes can run on one machine.
FEASIBLE_INGEST_INTERNAL_LISTEN=127.0.0.1:19402

# Complete static list of private app-shard URLs. Every ingester polls every URL
# for domains. The order is stable identity: app id 1 is first, id 2 is second.
# Append new shards; never reorder entries with buffered events. Add a shard
# before moving accounts onto it; remove retired shards only after they own no
# accounts and every outbox partition for them is empty.
FEASIBLE_INGEST_SHARDS=http://127.0.0.1:19401

# Private app endpoint that serves the two live fingerprint salts. Defaults to
# the first shard URL. Ingesters keep this material in memory only.
# FEASIBLE_INGEST_SALT_URL=http://127.0.0.1:19401

# Addresses allowed to supply forwarded client-address headers, comma-separated,
# as bare addresses or CIDR blocks. Empty means nobody, which is the right
# default: on an instance exposed straight to the internet, trusting those headers
# lets anyone forge their own geolocation and split their own fingerprint. All
# X-Feasible-IP, CF-Connecting-IP and X-Forwarded-For values are ignored unless
# the socket peer is listed here. Set this to your load balancer or edge proxy,
# and configure that proxy to strip or overwrite client-supplied X-Feasible-IP
# and CF-Connecting-IP values. An appending X-Forwarded-For proxy is supported.
# FEASIBLE_INGEST_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# Local durable outbox. Production puts this on a network-attached volume. An
# ingester returns 202 only after the derived event commits here.
FEASIBLE_INGEST_BUFFER_PATH=./data/ingest/buffer.db


# ── Replication — read by `feasible litestream`, by no serving process ────────

# Where the generated Litestream configuration is written. It is outside the
# data directory on purpose: this file describes how to recover that directory,
# and a copy that only exists inside the thing it recovers is not a recovery
# plan.
FEASIBLE_LITESTREAM_CONFIG=/etc/litestream.yml

# The prefix every database is replicated under. Each database gets one path
# segment below it — system, account-000001, account-000002 — so one bucket can
# hold every shard without a collision. Empty means replication is not
# configured, which is normal for a self-hoster and an outage waiting to happen
# on a shard. The bucket credentials are NOT set here: Litestream reads
# LITESTREAM_ACCESS_KEY_ID and LITESTREAM_SECRET_ACCESS_KEY from its own
# environment, so the generated file never carries a secret.
# FEASIBLE_LITESTREAM_REPLICA_URL=s3://feasible-backups/shard-01

# How often each database's new write-ahead log pages are shipped. One second is
# the recovery point this project promises. A local 202 does not prove the most
# recent WAL pages have reached object storage.
FEASIBLE_LITESTREAM_SYNC_SECONDS=1

# How often a full snapshot is taken. A restore replays log segments on top of
# the newest snapshot, so this is also how much replay a restore has to do.
FEASIBLE_LITESTREAM_SNAPSHOT_HOURS=6

# How long snapshots and log segments are kept. It must stay longer than the
# snapshot interval or retention deletes the snapshot a restore would replay
# onto, leaving a replica that cannot be restored at all.
# How often `feasible litestream config -watch` re-reads the account directory.
# An account database is created by that account's first event and Litestream
# reads its configuration once, so this is the window in which a brand-new
# account is on disk and not yet replicated.
FEASIBLE_LITESTREAM_WATCH_SECONDS=60

# The command run after the configuration file changes, which is how the daemon
# picks up a newly created account database. Empty by default because the right
# command depends on how Litestream is supervised, and guessing would produce a
# watcher that reloads nothing and says it worked.
# FEASIBLE_LITESTREAM_ON_CHANGE=systemctl restart litestream

# One fresh, atomic provider-evidence bundle validated before any production
# process starts and before replication configuration is written. The fetch
# script binds lifecycle, versioning, Object Lock and bucket-location responses
# to this exact replica bucket/prefix and publishes them with one rename.
# FEASIBLE_LITESTREAM_ATTESTATION=/etc/feasible/replica-attestation.json
